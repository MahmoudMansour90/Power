# Copy this file's contents into the app's real secrets, NOT into this
# file itself (this example file is safe to commit to GitHub; a real
# secrets.toml should never be committed).
#
# Local run:  copy this to .streamlit/secrets.toml (already gitignored)
#             and fill in a real password.
# Streamlit Community Cloud: go to your app -> Settings -> Secrets, and
#             paste the same content there instead. You do not need a
#             secrets.toml file in the repo at all for the deployed app.

app_password = "change-this-password"
